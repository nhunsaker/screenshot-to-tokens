      "$value": "{color.surface.card}",
      "$type": "color",
      "$description": "Card background is white surface.",
      "$extensions": {
        "com.metatoy.s2t": {
          "tier": "component",
          "clusters": [
            "color-17"
          ]
        }
      }
    },
    "border": {
      "$value": "{color.border.default}",
      "$type": "color",
      "$description": "Card borders use gray.100 cluster.",
      "$extensions": {
        "com.metatoy.s2t": {
          "tier": "component",
          "clusters": [
            "color-16"
          ]
        }
      }
    },
    "radius": {
      "$value": "{radius.md}",
      "$type": "dimension",
      "$description": "Card radius uses 6px cluster.",
      "$extensions": {
        "com.metatoy.s2t": {
          "tier": "component",
          "clusters": [
            "radius-02"
          ]
        }
      }
    },
    "shadow": {
      "$value": "{shadow.1}",
      "$type": "shadow",
      "$description": "Card box-shadow uses shadow.1 cluster.",
      "$extensions": {
        "com.metatoy.s2t": {
          "tier": "component",
          "clusters": [
            "shadow-01"
          ]
        }
      }
    }
  },
  "nav": {
    "bg": {
      "$value": "{color.surface.default}",
      "$type": "color",
      "$description": "Nav background is white surface.",
      "$extensions": {
        "com.metatoy.s2t": {
          "tier": "component",
          "clusters": [
            "color-17"
          ]
        }
      }
    },
    "border": {
      "$value": "{color.black-a10}",
      "$type": "color",
      "$description": "Nav border uses black-a10 cluster.",
      "$extensions": {
        "com.metatoy.s2t": {
          "tier": "component",
          "clusters": [
            "color-04"
          ]
        }
      }
    },
    "shadow": {
      "$value": "{shadow.1}",
      "$type": "shadow",
      "$description": "Nav box-shadow uses shadow.1 cluster.",
      "$extensions": {
        "com.metatoy.s2t": {
          "tier": "component",
          "clusters": [
            "shadow-01"
          ]
        }
      }
    }
  },
  "badge": {
    "bg": {
      "$value": "{color.gray.300}",
      "$type": "color",
      "$description": "Badge background uses gray.300 cluster.",
      "$extensions": {
        "com.metatoy.s2t": {
          "tier": "component",
          "clusters": [
            "color-11"
          ]
        }
