  "link": {
    "text": {
      "$value": "{color.black-a50}",
      "$type": "color",
      "$description": "Link text primarily uses black-a50 with 9 uses.",
      "$extensions": {
        "com.metatoy.s2t": {
          "tier": "component",
          "clusters": [
            "color-02"
          ]
        }
      }
    },
    "active": {
      "bg": {
        "$value": "{color.surface.default}",
        "$type": "color",
        "$description": "Active link background is white surface.",
        "$extensions": {
          "com.metatoy.s2t": {
