# Copy to .env (git-ignored). Every provider defaults to an offline stand-in,
# so the pipeline runs end to end with none of these set.

# ── Which provider runs each stage ───────────────────────────────────────────
# segment: mock (regions from DOM boxes, offline) | meta (SAM 3.1 via Meta Model API) | vision (Muse Spark boxes,
#          fallback if `s2t segeval` says SAM is NO-GO on UI) | local (SAM locally; needs CUDA, so not this Mac)
S2T_SEGMENTER=mock
# namer:   mock (deterministic heuristic namer) | ollama (local Llama) | meta (Muse Spark) | fireworks
S2T_NAMER=mock
# coder:   deterministic (CSS rewrite in this repo) | meta (Muse Code writes the PR, TODO)
S2T_CODER=deterministic

# ── Meta Model API (fill in from the Oct 26 docs + approval email) ───────────
# Class C (public, non-sensitive) data only. NEVER enable the "Contributor" tier: it trains on your data.
# META_API_KEY is read from the macOS Keychain (service "meta-hackathon-api") when unset; don't paste it here.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_NAMER_MODEL=muse-spark-1.3
META_SAM_MODEL=
META_VISION_MODEL=

# ── Local Llama via Ollama (OpenAI-compatible endpoint) ──────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b

# ── Fireworks (partner credit, $25) ──────────────────────────────────────────
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct

# ── Model storage ────────────────────────────────────────────────────────────
# Large downloads (Hugging Face weights, Ollama models) go to the external drive, not the internal disk.
S2T_MODELS_DIR=/Volumes/SanDisk/models
HF_HOME=/Volumes/SanDisk/models/huggingface
